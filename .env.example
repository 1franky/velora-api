# Copia este archivo a `.env` y ajusta los valores. `.env` no se versiona.
VELORA_DB_NAME=velora
VELORA_DB_USERNAME=velora
VELORA_DB_PASSWORD=
VELORA_DB_PORT=5432
VELORA_DB_URL=jdbc:postgresql://localhost:5432/velora
VELORA_API_PORT=8080

# Solo para crear el propietario una vez con `./gradlew bootstrapOwner`; bórralas después.
# VELORA_OWNER_EMAIL=
# VELORA_OWNER_PASSWORD=

# Carpeta de archivos originales (ADR-013). En producción, un volumen dedicado incluido en los backups.
VELORA_STORAGE_ORIGINALS_PATH=data/originals
