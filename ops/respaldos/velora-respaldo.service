# Respaldo de Velora (ADR-027). Instalar en /etc/systemd/system/ (ver ops/respaldos/README.md).
[Unit]
Description=Respaldo cifrado de Velora (PostgreSQL y originales) a Cloudflare R2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Usuario del grupo docker: no hace falta root.
User=francisco
EnvironmentFile=/etc/velora/respaldo.env
ExecStart=/home/francisco/docker/velora/velora-api/ops/respaldos/respaldar.sh
# Caché de restic fuera de /tmp para no volver a descargar índices cada vez.
Environment=RESTIC_CACHE_DIR=/home/francisco/.cache/restic
Nice=10
IOSchedulingClass=idle
