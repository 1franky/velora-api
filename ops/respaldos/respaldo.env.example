# /etc/velora/respaldo.env (dueño root, legible solo por el usuario del servicio: chmod 640, grupo francisco).
# Nunca se versiona. Ver ops/respaldos/README.md.

# Bucket privado de Cloudflare R2 (S3). <cuenta> es el ID de tu cuenta de Cloudflare.
RESTIC_REPOSITORY=s3:https://<cuenta>.r2.cloudflarestorage.com/velora-respaldos
# Token de R2 con permiso de lectura y escritura SOLO en ese bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Contraseña de cifrado de restic, en su propio archivo (chmod 640, grupo francisco). Sin ella NO se puede restaurar:
# guarda una copia en tu gestor de contraseñas.
RESTIC_PASSWORD_FILE=/etc/velora/restic-password

# Alertas: un fallo abre un issue en este repositorio. Token fine-grained con permiso "Issues: Read and write" solo
# en 1franky/velora-api.
VELORA_ALERT_REPO=1franky/velora-api
VELORA_ALERT_TOKEN=

# Opcionales (valores por omisión del despliegue):
# VELORA_PG_CONTAINER=velora-postgres
# VELORA_DB_NAME=velora
# VELORA_DB_USERNAME=velora
# VELORA_ORIGINALS_VOLUME=velora-originals
# VELORA_KEEP_DAILY=7
# VELORA_KEEP_WEEKLY=4
# VELORA_KEEP_MONTHLY=6
